# ============================================================
# InvestAI backend — PRODUCTION environment template
# Copy to .env (or set in your platform's env vars) and fill in.
# Never commit real secrets.
# ============================================================

NODE_ENV=production
PORT=4000

# Supabase PostgreSQL connection string (keeps Supabase as the database)
DATABASE_URL=postgresql://<user>:<password>@<supabase-host>:5432/postgres

# Comma-separated list of origins allowed to call the API.
# Leave CORS_ORIGINS unset to keep permissive CORS (not recommended in prod).
CORS_ORIGINS=https://your-frontend-domain.example

# Secret for /api/admin/summary and /api/admin/export.
# REQUIRED in production — the legacy "investai-admin" default is disabled
# when NODE_ENV=production.
ADMIN_TOKEN=<generate-a-long-random-secret>
